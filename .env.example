# Optional RevenueCat client SDK keys used by native builds.
# These are public app-specific SDK keys, not RevenueCat secret/server API keys.
# Keep server/secret keys out of Vite variables and the client bundle.
VITE_REVENUECAT_IOS_API_KEY=
VITE_REVENUECAT_ANDROID_API_KEY=

# Must exactly match the entitlement configured in RevenueCat (default: sie_plus).
VITE_REVENUECAT_ENTITLEMENT_ID=sie_plus

# Optional overrides. If omitted, the app matches RevenueCat package types
# (WEEKLY, MONTHLY, LIFETIME) from the current offering.
VITE_REVENUECAT_WEEKLY_PACKAGE_ID=
VITE_REVENUECAT_MONTHLY_PACKAGE_ID=
VITE_REVENUECAT_LIFETIME_PACKAGE_ID=

# Optional exact store product-ID overrides for the current RevenueCat offering.
VITE_REVENUECAT_WEEKLY_PRODUCT_ID=
VITE_REVENUECAT_MONTHLY_PRODUCT_ID=
VITE_REVENUECAT_LIFETIME_PRODUCT_ID=
